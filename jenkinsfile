pipeline{
	agent any

	stages{

		stage('Check Docker'){
			steps{
			sh 'docker --version'
			}
		}


		stage('Build Docker Image'){
		steps{
		sh 'docker build -t my-devops-app:$
	{BUILD_NUMBER}.'
		}
	}
	stage('Remove Old Container'){
	steps{
	sh'docker rm -f my-devops-container ||true'
	}
	}

	stage('Run Docker Container'){
	steps{
	sh'docker run -d -p 8081:80 --name my-devops-container my devops-app:$
	{BUILD_NUMBER}
	}	
	}

	stage('Test Website'){
		steps{
		sh 'curl --fail http://localhost:8081'
		}
	}
}
}
